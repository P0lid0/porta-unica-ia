# Chave da API da Anthropic (rota externa). Sem ela, só a rota local funciona.
ANTHROPIC_API_KEY=
# Só se a chave não estiver vinculada a um workspace (erro "anthropic-workspace-id"): ID do workspace, começa com wrkspc_
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-5-5

# Modelo local (Ollama) — rota sensível
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL=gpt-oss:20b
EMBED_MODEL=bge-m3

PORTA=3340
